---
import "@fontsource-variable/cairo";
import "@fontsource/tajawal/400.css";
import "@fontsource/tajawal/500.css";
import "@fontsource/tajawal/700.css";
import "../styles/global.css";
import { url } from "../lib/url";
import { execSync } from "node:child_process";
import pkg from "../../package.json";

interface Props {
  title?: string;
}
const { title = "لوحة التحكم" } = Astro.props;

// Short commit hash tells you which deploy is live; empty off-git builds.
const sha = (() => {
  try {
    return execSync("git rev-parse --short HEAD", { encoding: "utf8" }).trim();
  } catch {
    return "";
  }
})();
---

<!doctype html>
<html lang="ar" dir="rtl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="supabase-url" content={import.meta.env.PUBLIC_SUPABASE_URL} />
    <meta name="supabase-key" content={import.meta.env.PUBLIC_SUPABASE_ANON_KEY} />
    <title>{title} | التحالف السوداني للإنتان</title>
    <link rel="icon" type="image/svg+xml" href={url("favicon.svg")} />
    <script is:inline src={url("push-client.js")} defer></script>
  </head>
  <body>
    <main class="admin-shell">
      <header class="admin-top">
        <a class="admin-brand" href={url()}>التحالف السوداني للإنتان</a>
        <span class="admin-top-link" dir="ltr">
          v{pkg.version}{sha && <span class="sha"> · {sha}</span>}
        </span>
      </header>
      <slot />
    </main>
  </body>
</html>