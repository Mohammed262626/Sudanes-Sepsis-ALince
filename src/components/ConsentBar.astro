---
// One-time(ish) notice: the page needs the camera at check-in and notifications
// for conference alerts. Until both are allowed the bar keeps coming back; once
// everything is granted it never shows again. If the browser allows
// notifications but cannot save the push subscription, the bar demotes itself
// to one quiet line for 24h instead of repeating a failing attempt every visit.
---

<aside class="consent" id="consent" hidden aria-label="إشعار الخصوصية والأذونات">
  <div class="consent-quiet" hidden>
    <p id="consent-quiet-text">الإشعارات مسموحة، لكن المتصفح لم يُكمل تسجيلها على هذا الجهاز.</p>
    <div class="consent-quiet-actions">
      <button class="btn btn--sm" type="button" data-retry>أعد المحاولة</button>
      <button class="btn btn--ghost btn--sm" type="button" data-hide>لاحقاً</button>
    </div>
  </div>
  <div class="consent-body">
    <p class="consent-title">نحتاج إذنكم مرة واحدة</p>
    <p class="consent-lead">
      لا نستخدم كوكيز تتبّع، ولا نطلب شيئاً لا تحتاجه الصفحة.
    </p>
    <ul class="consent-list">
      <li data-item="camera">
        <span class="consent-label">
          <strong>الكاميرا</strong>
          <span>لمسح رمز البوابة عند تسجيل الحضور.</span>
        </span>
        <span class="consent-state" data-state="prompt">بانتظار الإذن</span>
      </li>
      <li data-item="notify">
        <span class="consent-label">
          <strong>الإشعارات</strong>
          <span>لتنبيهات المؤتمر حتى لو أغلقتم الموقع.</span>
        </span>
        <span class="consent-state" data-state="prompt">بانتظار الإذن</span>
      </li>
      <li data-item="store">
        <span class="consent-label">
          <strong>حفظ التفضيلات</strong>
          <span>في متصفحكم فقط، بلا حساب.</span>
        </span>
        <span class="consent-state" data-state="ok">تلقائي</span>
      </li>
    </ul>
  </div>
  <div class="consent-actions">
    <button class="btn" type="button" id="consent-all">السماح للكل</button>
    <button class="btn btn--ghost" type="button" id="consent-later">لاحقاً</button>
  </div>
</aside>

<script is:inline>
  (() => {
    const box = document.getElementById("consent");
    if (!box) return;

    // The stored flag is only a cache: permissions can be deleted in the browser
    // later, so every visit re-checks the real state before trusting it.

    const cameraState = box.querySelector('[data-item="camera"] .consent-state');
    const notifyState = box.querySelector('[data-item="notify"] .consent-state');
    const quietNote = box.querySelector(".consent-quiet");
    const quietText = box.querySelector("#consent-quiet-text");

    const labels = {
      granted: "مسموح",
      warn: "مسموح — تعذّر تسجيل التنبيهات",
      denied: "مرفوض — فعّله من إعدادات المتصفح",
      prompt: "بانتظار الإذن",
      unsupported: "غير متاح في هذا المتصفح",
    };

    const paint = (el, state) => {
      el.dataset.state = state;
      el.textContent = labels[state] ?? labels.prompt;
    };

    const PUSH_FAIL = "sep-push-fail";
    const DAY = 24 * 60 * 60 * 1000;

    const isIOS = () =>
      /iPhone|iPad|iPod/.test(navigator.userAgent) ||
      (navigator.platform === "MacIntel" && navigator.maxTouchPoints > 1);
    const isStandalone = () =>
      window.matchMedia?.("(display-mode: standalone)").matches ||
      navigator.standalone === true;
    // Links opened from WhatsApp/Instagram and other apps run in a webview,
    // where web push cannot be registered at all.
    const isWebview = () => /; wv\)|FBAN|FBAV|Instagram|Line\//i.test(navigator.userAgent);

    const pushHint = () => {
      if (isIOS() && !isStandalone()) {
        return "للآيفون: أضِف الموقع إلى الشاشة الرئيسية (مشاركة ← إضافة إلى الشاشة الرئيسية) ثم افتحه من هناك لتصل التنبيهات.";
      }
      if (isWebview()) {
        return "افتح الرابط في متصفح كامل (Chrome أو Safari) لتصل التنبيهات.";
      }
      return "مسموح — تعذّر تسجيل التنبيهات على هذا الجهاز. سنحاول تلقائياً لاحقاً.";
    };

    const queryCamera = async () => {
      if (!navigator.mediaDevices?.getUserMedia) return "unsupported";
      try {
        const status = await navigator.permissions.query({ name: "camera" });
        return status.state;
      } catch {
        return "prompt";
      }
    };

    const stateOfNotify = () => {
      if (typeof Notification === "undefined") return "unsupported";
      return Notification.permission; // granted | denied | default
    };

    const normal = (state) => (state === "default" ? "prompt" : state);

    let camera = "prompt";
    let notify = "prompt";
    // null = not applicable here (no push API); false = allowed but not saved.
    let subscribed = null;

    // Everything the page can actually use is allowed (or not offered here).
    const settled = () =>
      (camera === "granted" || camera === "unsupported") &&
      (notify === "granted" || notify === "unsupported") &&
      subscribed !== false;

    const rememberFail = () => {
      try {
        localStorage.setItem(PUSH_FAIL, String(Date.now()));
      } catch {
        // Nothing to store; the hint still shows this visit.
      }
    };

    const forgetFail = () => {
      try {
        localStorage.removeItem(PUSH_FAIL);
      } catch {
        // Nothing stored.
      }
    };

    const refresh = async () => {
      camera = normal(await queryCamera());
      notify = normal(stateOfNotify());
      paint(cameraState, camera);

      let subscriptionBlocked = false;
      if (notify === "granted") {
        let failedAt = 0;
        try {
          failedAt = Number(localStorage.getItem(PUSH_FAIL) || 0);
        } catch {
          // Treat as no previous failure.
        }
        // A failure in the last 24h: skip the attempt that we know fails, keep
        // the note quiet. Older than that: try again by itself.
        if (failedAt > 0 && Date.now() - failedAt < DAY) {
          subscribed = false;
          subscriptionBlocked = true;
        } else {
          const saved = await window.sepPush?.();
          subscribed = saved === true;
          subscriptionBlocked = !subscribed;
          if (subscribed) forgetFail();
          else rememberFail();
        }
        paint(notifyState, subscribed ? "granted" : "warn");
        if (subscriptionBlocked) notifyState.textContent = pushHint();
      } else {
        subscribed = null;
        paint(notifyState, notify);
      }

      if (settled()) {
        try {
          localStorage.setItem("sep-consent", "granted");
        } catch {
          // Nothing to store; the bar still closes for this visit.
        }
        forgetFail();
        box.remove();
        return true;
      }

      // Only the browser's own push registration is missing (permission is
      // already granted): one quiet line, not the full ask.
      const quiet =
        (camera === "granted" || camera === "unsupported") &&
        notify === "granted" &&
        subscriptionBlocked;
      if (quiet && quietNote) {
        if (quietText) quietText.textContent = pushHint();
        box.dataset.mode = "quiet";
        quietNote.hidden = false;
      } else {
        box.dataset.mode = "";
        if (quietNote) quietNote.hidden = true;
      }

      // Missing anything (revoked, never asked, or subscribe failed): show it.
      box.removeAttribute("hidden");
      return false;
    };

    // Browsers only prompt inside a click. Asking for the camera is the only
    // honest way: open a stream and stop it at once.
    async function allowAll() {
      const button = document.getElementById("consent-all");
      if (button) button.disabled = true;
      try {
        if (camera === "prompt") {
          try {
            const stream = await navigator.mediaDevices.getUserMedia({ video: true });
            stream.getTracks().forEach((t) => t.stop());
          } catch {
            // Refused or no camera: the status line says so.
          }
        }
        if (notify === "prompt") {
          try {
            await Notification.requestPermission();
          } catch {
            // Old Safari: nothing to ask.
          }
        }
      } finally {
        if (button) button.disabled = false;
      }
      await refresh();
    }

    document.getElementById("consent-all")?.addEventListener("click", allowAll);

    // «لاحقاً» hides it for this page view only — the reminder returns next visit.
    document.getElementById("consent-later")?.addEventListener("click", () => box.remove());

    // Retry now — e.g. after adding the site to the home screen on iOS.
    quietNote?.querySelector("[data-retry]")?.addEventListener("click", async () => {
      forgetFail();
      await refresh();
    });
    quietNote?.querySelector("[data-hide]")?.addEventListener("click", () => box.remove());

    refresh();
  })();
</script>

<style>
  .consent {
    position: fixed;
    inset-inline: 0;
    inset-block-end: 0;
    z-index: 50;
    display: flex;
    align-items: flex-end;
    gap: 1.25rem;
    padding: 1.15rem 1.5rem;
    border-block-start: 2px solid var(--ink);
    background: var(--paper);
  }

  .consent[hidden] {
    display: none;
  }

  .consent-body {
    flex: 1;
    display: grid;
    gap: 0.45rem;
  }

  .consent-title {
    margin: 0;
    font-family: var(--font-display, inherit);
    font-size: 1.05rem;
    font-weight: 700;
  }

  .consent-lead {
    margin: 0;
    font-size: 0.875rem;
    color: color-mix(in srgb, var(--ink) 70%, var(--paper));
  }

  .consent-list {
    list-style: none;
    margin: 0.15rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.4rem;
  }

  .consent-list li {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 0.35rem;
    border-block-start: 1px solid color-mix(in srgb, var(--ink) 18%, var(--paper));
    font-size: 0.9375rem;
  }

  .consent-label {
    display: flex;
    flex-wrap: wrap;
    gap: 0.15rem 0.5rem;
  }

  .consent-label span {
    color: color-mix(in srgb, var(--ink) 65%, var(--paper));
    font-size: 0.875rem;
  }

  .consent-state {
    flex: none;
    font-size: 0.8125rem;
    white-space: nowrap;
    color: color-mix(in srgb, var(--ink) 60%, var(--paper));
  }

  .consent-state[data-state="granted"],
  .consent-state[data-state="ok"] {
    color: var(--ok);
  }

  .consent-state[data-state="denied"] {
    color: var(--accent);
  }

  .consent-state[data-state="warn"] {
    color: var(--accent);
    white-space: normal;
  }

  .consent-actions {
    flex: none;
    display: grid;
    gap: 0.5rem;
    min-inline-size: 10rem;
  }

  /* Quiet mode: permission is fine, only the browser's push registration is
     not — one line instead of the whole ask. */
  .consent[data-mode="quiet"] {
    padding-block: 0.9rem;
  }

  .consent[data-mode="quiet"] .consent-body,
  .consent[data-mode="quiet"] .consent-actions {
    display: none;
  }

  .consent-quiet {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .consent-quiet[hidden] {
    display: none;
  }

  .consent-quiet p {
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.55;
  }

  .consent-quiet-actions {
    flex: none;
    display: flex;
    gap: 0.5rem;
  }

  @media (max-width: 48rem) {
    .consent {
      flex-direction: column;
      align-items: stretch;
      gap: 0.85rem;
      padding: 1rem 1.1rem;
      max-block-size: 70vh;
      overflow-y: auto;
    }

    .consent-actions {
      grid-template-columns: 1fr 1fr;
      min-inline-size: 0;
    }

    .consent-quiet {
      flex-direction: column;
      align-items: stretch;
      gap: 0.75rem;
    }
  }
</style>