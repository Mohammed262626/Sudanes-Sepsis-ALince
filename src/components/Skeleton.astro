---
// Static placeholder shown while a client:only island loads its JS — pure
// markup, no JS, styled by the shared skeleton classes in global.css.
---
<div class="skel-fallback">
  <div class="skel-card" aria-hidden="true">
    <p class="skel-band"></p>
    <div class="skel-card-body">
      <span class="skel skel-t"></span>
      <span class="skel skel-l"></span>
      <span class="skel skel-l skel-w60"></span>
      <span class="skel skel-btn"></span>
    </div>
  </div>
</div>
