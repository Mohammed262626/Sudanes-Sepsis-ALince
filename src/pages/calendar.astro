---
import "@fontsource-variable/cairo";
import "@fontsource/tajawal/400.css";
import "../styles/global.css";
import { url } from "../lib/url";

// One link from WhatsApp, the right calendar on each phone: iOS gets the .ics
// (Safari hands it to Apple Calendar), everyone else the Google template URL.
const ics = url("conference.ics");
const google =
  "https://calendar.google.com/calendar/render?action=TEMPLATE" +
  "&text=" + encodeURIComponent("مؤتمر كسلا للإنتان") +
  "&dates=20261130T090000/20261130T150000" +
  "&ctz=Africa/Khartoum" +
  "&location=" + encodeURIComponent("كسلا، السودان") +
  "&details=" + encodeURIComponent("التحالف السوداني للإنتان — 9:00 صباحاً إلى 3:00 عصراً بتوقيت الخرطوم.");
---

<!doctype html>
<html lang="ar" dir="rtl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="referrer" content="no-referrer" />
    <meta name="theme-color" content="#f7f5f0" />
    <title>إضافة الموعد إلى التقويم</title>
  </head>
  <body>
    <main>
      <p class="kicker">مؤتمر كسلا للإنتان</p>
      <h1>جارٍ فتح التقويم...</h1>
      <p class="links">
        <a href={ics}>تقويم آبل</a>
        <span aria-hidden="true">·</span>
        <a href={google}>Google Calendar</a>
      </p>
    </main>

    <script is:inline define:vars={{ ics, google }}>
      const ua = navigator.userAgent;
      const ios = /iPhone|iPad|iPod/i.test(ua) || (/Macintosh/i.test(ua) && navigator.maxTouchPoints > 1);
      location.replace(ios ? ics : google);
    </script>

    <style is:global>
      body {
        display: grid;
        place-items: center;
        min-block-size: 100vh;
        min-block-size: 100dvh;
        padding: 1.25rem;
        background: var(--paper);
        text-align: center;
      }

      main {
        display: grid;
        gap: 0.75rem;
        max-inline-size: 28rem;
      }

      .kicker {
        margin: 0;
        font-size: 0.8125rem;
      }

      h1 {
        margin: 0;
        font-family: var(--font-display);
        font-size: 1.375rem;
      }

      .links {
        display: flex;
        justify-content: center;
        gap: 0.5rem;
        margin: 0;
        font-size: 0.9375rem;
      }
    </style>
  </body>
</html>