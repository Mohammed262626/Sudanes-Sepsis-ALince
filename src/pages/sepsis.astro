import Base from "../layouts/Base.astro";
---

<Base
  title="ما هو الإنتان؟ | التحالف السوداني للإنتان"
  description="الإنتان (تعفن الدم) استجابة خطيرة للجسم تجاه عدوى، وقد يؤدي إلى فشل الأعضاء والوفاة. تعرّف على الأسباب والفئات الأكثر عرضة للخطر."
>
  <div class="page-head wrap">
    <p class="kicker">التوعية</p>
    <h1>الإنتان: عندما تتحول العدوى إلى خطر.</h1>
    <p class="lede">
      الإنتان، المعروف شعبياً بتعفن الدم، هو استجابة الجسم المفرطة لعدوى.
      يبدأ الجهاز المناعي بمهاجمة الأنسجة والأعضاء بدلاً من الميكروب وحده،
      وقد يتطور إلى صدمة إنتانية وفشل أعضاء متعددة خلال ساعات.
    </p>
  </div>

  <div class="section wrap">
    <div class="prose">
      <h2>كيف يحدث؟</h2>
      <p>
        غالباً يبدأ الإنتان بعدوى بكتيرية، وأحياناً فيروسية أو فطرية. أكثر
        مصادر العدوى شيوعاً هي الرئة، المسالك البولية، البطن، والجلد. عند
        دخول الميكروب إلى الدم أو انتشاره في الجسم، تطلق الاستجابة المناعية
        مواد التهابية تؤثر على الأوعية الدموية وضغط الدم ووظائف الأعضاء.
      </p>
      <p>
        لا يحتاج الإنتان إلى عدوى شديدة في البداية. حتى عدوى بسيطة لم تُعالج
        في وقتها قد تتطور إلى حالة مهددة للحياة.
      </p>

      <div class="callout">
        <p>
          الإنتان حالة طارئة. كل ساعة تأخير في التشخيص والعلاج ترفع خطر الوفاة.
        </p>
      </div>

      <h2>من هم الأكثر عرضة للخطر؟</h2>
      <ul>
        <li>الأطفال حديثو الولادة والرضّع.</li>
        <li>كبار السن، خاصة من تجاوزوا 65 عاماً.</li>
        <li>الحوامل والنفاس.</li>
        <li>من يعانون من ضعف المناعة أو يتلقون علاجاً مثبطاً للمناعة.</li>
        <li>المصابون بأمراض مزمنة كالسكري وأمراض الكلى والكبد.</li>
        <li>من خضعوا لجراحة حديثة أو لديهم قسطرة أو خطوط وريدية.</li>
      </ul>

      <h2>لماذا يهمنا في السودان؟</h2>
      <p>
        يواجه نظامنا الصحي تحديات في الوصول المبكر إلى الرعاية، ونقصاً في
        أسرّة العناية المركزة والمضادات الحيوية المناسبة، إضافة إلى ضعف
        الوعي المجتمعي بعلامات الخطر. هذه العوامل تجعل سرعة التعرّف على
        الإنتان والتصرف حياله أمراً حاسماً.
      </p>

      <h2>ماذا يمكن فعله؟</h2>
      <p>
        الكشف المبكر والعلاج السريع بالمضادات الحيوية والسوائل الوريدية
        يغيّران مسار المرض. الوعي بعلامات الخطر، وطلب الرعاية فوراً، وعدم
        الانتظار حتى تتفاقم الحالة، هي خطوات بسيطة تنقذ الأرواح.
      </p>
      <p>
        <a class="btn" href="/symptoms">تعرّف على علامات الخطر</a>
      </p>
      <p style="margin-top: 2rem; font-size: .875rem; color: var(--muted);">
        هذه المعلومات للتوعية العامة ولا تغني عن استشارة الطبيب. المصدر:
        منظمة الصحة العالمية.
      </p>
    </div>
  </div>
</Base>
