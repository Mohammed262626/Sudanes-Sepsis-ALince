---
import Base from "../layouts/Base.astro";
import { url } from "../lib/url";
---

<Base
  title="مؤتمر كسلا للإنتان 2026 | التحالف السوداني للإنتان"
  description="مؤتمر كسلا للإنتان — التفاصيل والتسجيل قريباً."
>
  <article class="soon">
    <p class="kicker">التحالف السوداني للإنتان</p>
    <h2 class="soon-title">مؤتمر كسلا للإنتان</h2>
    <h1 class="soon-headline">قريباً.</h1>
    <p class="soon-lede">
      لقاء وطني يجمع الكوادر الصحية وصنّاع القرار لمناقشة الكشف المبكر عن
      الإنتان والاستجابة السريعة له في السودان.
    </p>
    <hr class="soon-rule" />
    <p class="soon-note">
      سيُعلن هنا التاريخ والمكان وفتح التسجيل.
      <a href={url("#contact")}>تواصل معنا</a> للاستفسار.
    </p>
  </article>
</Base>

<style>
  .soon {
    max-width: 44rem;
    margin: 0 auto;
    padding-block: clamp(4rem, 10vw, 8rem);
    text-align: center;
  }

  .soon-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.25rem, 3vw, 1.75rem);
    margin-block: 0 0.5rem;
  }

  .soon-headline {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(4.5rem, 15vw, 9rem);
    line-height: 1;
    margin-block: 0.5rem 1rem;
  }

  .soon-lede {
    max-width: 38rem;
    margin-inline: auto;
    color: var(--muted);
    font-size: clamp(1.0625rem, 2vw, 1.1875rem);
    margin-bottom: 2.5rem;
  }

  .soon-rule {
    border: none;
    border-top: 1px solid var(--line);
    max-width: 12rem;
    margin-block: 0 1.5rem;
  }

  .soon-note {
    color: var(--muted);
    font-size: 0.9375rem;
  }
</style>