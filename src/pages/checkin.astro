---
import arabic400 from "@fontsource/ibm-plex-sans-arabic/files/ibm-plex-sans-arabic-arabic-400-normal.woff2?url";
import arabic600 from "@fontsource/ibm-plex-sans-arabic/files/ibm-plex-sans-arabic-arabic-600-normal.woff2?url";
import arabic700 from "@fontsource/ibm-plex-sans-arabic/files/ibm-plex-sans-arabic-arabic-700-normal.woff2?url";
import "../styles/global.css";
import CheckInCard from "../components/CheckInCard.svelte";
---

<!doctype html>
<html lang="ar" dir="rtl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="referrer" content="no-referrer" />
    <meta name="theme-color" content="#f7f5f0" />
    <title>تأكيد الحضور | التحالف السوداني للتسمم الدموي</title>
    <style is:inline>
      @font-face {
        font-family: "IBM Plex Sans Arabic";
        font-style: normal;
        font-weight: 400;
        font-display: optional;
        src: url({arabic400}) format("woff2");
      }
      @font-face {
        font-family: "IBM Plex Sans Arabic";
        font-style: normal;
        font-weight: 600;
        font-display: optional;
        src: url({arabic600}) format("woff2");
      }
      @font-face {
        font-family: "IBM Plex Sans Arabic";
        font-style: normal;
        font-weight: 700;
        font-display: optional;
        src: url({arabic700}) format("woff2");
      }
    </style>
  </head>
  <body>
    <main>
      <CheckInCard client:only="svelte" />
    </main>

    <style is:global>
      body {
        display: grid;
        place-items: center;
        min-block-size: 100vh;
        min-block-size: 100dvh;
        padding: 1.25rem;
        background: var(--paper);
      }

      main {
        inline-size: 100%;
        display: grid;
        place-items: center;
      }
    </style>
  </body>
</html>