---
// Legacy path: guests received /checkin links (and QR codes) in already-delivered
// WhatsApp messages. Preserve the query and send them to the moved page.
import { url } from "../lib/url";

const to = url("conference/checkin/");
---

<script is:inline define:vars={{ to }}>
  location.replace(to + location.search + location.hash);
</script>
<meta http-equiv="refresh" content="0;url={to}" />
