---
// Legacy path: guests received /guest links in already-delivered WhatsApp
// messages. Preserve the query and send them to the moved page.
import { url } from "../lib/url";

const to = url("conference/guest/");
---

<script is:inline define:vars={{ to }}>
  location.replace(to + location.search + location.hash);
</script>
<meta http-equiv="refresh" content="0;url={to}" />
