---
import Base from "../layouts/Base.astro";
import { supabase } from "../lib/supabase";

const { data: activities } = supabase
  ? await supabase
      .from("activities")
      .select("id, title, excerpt, published_at")
      .order("published_at", { ascending: false })
  : { data: [] };

const dateFmt = new Intl.DateTimeFormat("ar-SD", {
  day: "numeric",
  month: "long",
  year: "numeric",
});
---

<Base
  title="أنشطتنا | التحالف السوداني للإنتان"
  description="آخر أنشطة التحالف السوداني للإنتان: حملات توعية، ورش تدريبية، وشراكات."
>
  <div class="page-head wrap">
    <p class="kicker">أنشطتنا</p>
    <h1>ما نقوم به، على الأرض.</h1>
    <p class="lede">
      حملات توعية مجتمعية، ورش تدريب للكوادر الصحية، وشراكات وطنية — كل نشاط
      يقرّبنا من هدف واحد: تقليل الوفيات بسبب الإنتان.
    </p>
  </div>

  <section class="section wrap">
    {
      activities && activities.length > 0 ? (
        <div class="rows">
          {activities.map((a) => (
            <article class="row" style="grid-template-columns: 10rem 1fr auto;">
              <time
                class="idx"
                datetime={a.published_at}
                style="color: var(--muted);"
              >
                {dateFmt.format(new Date(a.published_at))}
              </time>
              <div>
                <h3>{a.title}</h3>
                <p>{a.excerpt}</p>
              </div>
            </article>
          ))}
        </div>
      ) : (
        <p>لا توجد أنشطة منشورة بعد. تابعنا قريباً.</p>
      )
    }
  </section>
</Base>
