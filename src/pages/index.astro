---
import Base from "../layouts/Base.astro";
import ConferenceBand from "../components/ConferenceBand.svelte";
---

<Base home>
  <ConferenceBand client:idle />

  <!-- 1. Hero (kept as-is) -->
  <section class="hero-home" id="top">
    <div class="hero-inner wrap">
      <div>
        <p class="kicker">التحالف السوداني للتسمم الدموي</p>
        <h1>
          <span>التسمم الدموي يقتل</span>
          <span>11 مليون إنسان</span>
          <span>كل عام حول العالم</span>
        </h1>
      </div>
      <aside class="hero-panel" aria-label="رسالتنا">
        <h2>معاً يمكننا تغيير هذا.</h2>
        <p>
          المعرفة هي أول خط دفاع. تعلّم العلامات، وتصرّف بسرعة، وساعدنا في نشر
          الوعي في كل بيت.
        </p>
        <div class="actions">
          <a class="btn" href="#symptoms">تعرّف على علامات الخطر</a>
          <a class="btn btn--ghost" href="#about">انضم إلينا</a>
        </div>
      </aside>
    </div>
    <a class="scroll-cue" href="#symptoms" tabindex="-1" aria-hidden="true">↓</a>
    <svg class="hero-cut" viewBox="0 0 100 12" preserveAspectRatio="none" aria-hidden="true">
      <polygon points="0,0 0,12 100,12" />
    </svg>
  </section>

  <!-- 2. Symptoms strip (Stitch-faithful, 3 equal cards) -->
  <section class="section wrap reveal" id="symptoms">
    <div class="strip-grid">
      <!-- Card 1: AMR -->
      <article class="s-card">
        <div class="s-card-body">
          <span class="icon-tile icon-tile--slate">
            <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3l7 3v5c0 5-3.5 8-7 9-3.5-1-7-4-7-9V6z" /></svg>
          </span>
          <span class="pill pill--slate">خطر صامت</span>
          <h3>مقاومة المضادات الحيوية والإنتان</h3>
          <p>
            الاستخدام العشوائي للأدوية والمضادات دون إشراف طبي يفاقم مقاومة
            البكتيريا في السودان، مما يجعل علاج العدوى البسيطة أصعب ويرفع خطر
            الإنتان.
          </p>
        </div>
        <div class="s-card-foot">
          <a class="accent-link" href="#about">إرشادات الاستخدام الرشيد ←</a>
        </div>
      </article>

      <!-- Card 2: Symptoms Guide (rose, accent border) -->
      <article class="s-card s-card--rose">
        <div class="s-card-body">
          <span class="icon-tile icon-tile--accent">
            <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M2 12h4l3-7 4 14 3-7h6" /></svg>
          </span>
          <span class="pill pill--accent">انتبه للعلامات الحيوية</span>
          <h3>ما هي علامات وأعراض الإنتان؟</h3>
          <ul class="dot-list">
            <li>هبوط أو ارتفاع حاد في درجة الحرارة ورجفة شديدة.</li>
            <li>تسارع غير مبرر في نبضات القلب وصعوبة التنفس.</li>
            <li>تشوش ذهني، نعاس مفرط أو تلعثم في الكلام.</li>
            <li>برودة الأطراف، شحوب الجلد أو تبقعات مزرقة.</li>
            <li>انحباس البول أو قلة التبول.</li>
          </ul>
        </div>
        <div class="s-card-foot">
          <p class="care-warn">
            إذا ظهرت علامة واحدة أو أكثر مع عدوى معروفة أو مشتبهة، اذهب إلى أقرب
            مستشفى أو مركز طوارئ فوراً — لا تنتظر.
          </p>
        </div>
      </article>

      <!-- Card 3: Support Services -->
      <article class="s-card" id="support">
        <div class="s-card-body">
          <span class="icon-tile icon-tile--slate">
            <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12a8 8 0 0 1 16 0" /><path d="M12 12a3 3 0 0 1 3 3v2H9v-2a3 3 0 0 1 3-3z" /></svg>
          </span>
          <span class="pill pill--slate">شبكة التضامن الميداني</span>
          <h3>خدمات الدعم ورعاية الناجين</h3>
          <p>
            سواء فقدتَ عزيزاً بسبب الإنتان أو كنت تتعافى من مضاعفاته، تعمل فرقنا
            على تقديم الإرشاد الطبي والنفسي لمساندة الأسر والمتعافين في شتى
            ربوع السودان.
          </p>
        </div>
        <div class="s-card-foot">
          <a class="accent-link" href="#about">تواصل مع فريق الدعم ←</a>
        </div>
      </article>
    </div>
  </section>

  <!-- 3. What we do (Stitch #about, white band) -->
  <section class="band band--paper id-rule-y" id="about">
    <div class="wrap s-split">
      <!-- Col intro -->
      <div class="s-intro">
        <span class="pill pill--rose">رؤيتنا ورسالتنا الإنسانية</span>
        <h2 class="three-tone-stack">
          <span>ما نقوم</span>
          <span>به في</span>
          <span>السودان</span>
        </h2>
        <span class="rule-accent" aria-hidden="true"></span>
        <p>
          منظمة تطوعية وطنية غير ربحية تأسست بمبادرة من أطباء واستشاريي
          العناية المكثفة والطب الوقائي وممثلي المجتمع المدني في السودان.
        </p>
      </div>
      <!-- Col content -->
      <div class="s-main">
        <p class="s-lead">
          يهدف تحالف الإنتان في السودان إلى إنهاء الوفيات التي يمكن الوقاية
          منها، ورفع جودة الرعاية الطارئة لمرضى الإنتان في المشافي الحكومية
          والريفية والمخيمات ومراكز الإيواء.
        </p>
        <div class="program-grid">
          <div class="program-card">
            <h4>
              <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M14 3v4a1 1 0 0 0 1 1h4" /><path d="M17 21H7a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h7l5 5v11a2 2 0 0 1-2 2z" /></svg>
              تطبيق حزمة الإنقاذ السداسية (Sepsis Six)
            </h4>
            <p>
              ندرب الأطباء وفرق التمريض على حزمة الإجراءات الستة المنقذة للحياة
              خلال الساعة الأولى: الأكسجين، تحاليل حمض اللاكتيك، مزارع الدم،
              السوائل الوريدية، والمضادات الحيوية الوريدية العاجلة.
            </p>
          </div>
          <div class="program-card">
            <h4 class="program-card--slate">
              <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 11l18-6-6 18-2-8-10-4z" /></svg>
              التوعية المجتمعية والوصول للولايات
            </h4>
            <p>
              نطلق حملات تثقيف باللغات واللهجات المحلية في القرى والمراكز الصحية
              حول خطورة إهمال الحمّيات والملاريا وجروح العمليات والولادة، وتأهيل
              القابلات والمساعدين الطبيين للكشف السريع.
            </p>
          </div>
        </div>
        <div class="s-actions">
          <a class="btn" href="#support">انضم إلينا ←</a>
          <a class="btn btn--ghost" href="#symptoms">
            <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 12l2 2 4-4" /><path d="M12 3l7 3v5c0 5-3.5 8-7 9-3.5-1-7-4-7-9V6z" /></svg>
            دليل الفحص والبروتوكول السريري
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- 4. Stories (kept as-is, gated placeholder) -->
  <section class="stories reveal" aria-labelledby="story-heading">
    <div class="wrap">
      <div class="carousel">
        <article class="sscontainer">
          <div class="text-section">
            <p class="kicker">قصص من الميدان</p>
            <h2 id="story-heading">لكل مريض قصة تستحق أن تُروى.</h2>
            <p class="excerpt">
              نعمل على توثيق تجارب حقيقية من السودان، بموافقة أصحابها.
            </p>
            <p class="note">
              قبل أي نشر تخضع التفاصيل الطبية لمراجعة سريرية.
            </p>
            <button class="btn btn--light" type="button" disabled>
              اقرأ القصة
            </button>
          </div>
          <div class="image-section">
            <span class="placeholder">قريباً</span>
          </div>
        </article>
        <div class="carousel-nav">
          <button type="button" disabled aria-label="الشريحة السابقة">›</button>
          <button type="button" disabled aria-label="الشريحة التالية">‹</button>
        </div>
        <div class="dots" aria-hidden="true"><span class="active"></span></div>
      </div>
    </div>
  </section>

  <!-- 5. Impact (Stitch metric cards, real WHO numbers) -->
  <section class="band band--paper id-rule-t" id="impact">
    <div class="wrap">
      <div class="impact-head">
        <span class="pill pill--slate">الأدلة السريرية ومؤشرات العبء العالمي</span>
        <h2>أثر التسمم الدموي</h2>
        <span class="rule-accent" aria-hidden="true"></span>
      </div>
      <div class="impact-cards">
        <!-- Metric 1: cases -->
        <div class="m-card">
          <div class="m-top">
            <span class="icon-tile icon-tile--accent">
              <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v2M5 6l1.5 1.5M19 6l-1.5 1.5M4 13h2M18 13h2M12 23a9 9 0 0 1-9-9 9 9 0 0 1 9-9 9 9 0 0 1 9 9 9 9 0 0 1-9 9z" /></svg>
            </span>
            <span class="pill pill--rose">حالات سنوية</span>
          </div>
          <div class="m-num"><span class="m-big">49</span> <span class="m-unit">مليون</span></div>
          <p>حالة تسمم دموي تُسجَّل سنوياً في العالم.</p>
          <div class="m-foot"><span>العبء العالمي للإنتان</span></div>
        </div>
        <!-- Metric 2: deaths -->
        <div class="m-card">
          <div class="m-top">
            <span class="icon-tile icon-tile--slate">
              <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3l7 3v5c0 5-3.5 8-7 9-3.5-1-7-4-7-9V6z" /></svg>
            </span>
            <span class="pill pill--rose">وفيات سنوية</span>
          </div>
          <div class="m-num"><span class="m-big">11</span> <span class="m-unit">مليون</span></div>
          <p>وفاة سنوياً، كثير منها كان يمكن منعه.</p>
          <div class="m-foot"><span>كثير منها يمكن تفاديه</span></div>
        </div>
        <!-- Metric 3: percent -->
        <div class="m-card">
          <div class="m-top">
            <span class="icon-tile icon-tile--rose">
              <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 17l6-6 4 4 8-8" /><path d="M21 7v6h-6" /></svg>
            </span>
            <span class="pill pill--rose">نسبة الوفيات</span>
          </div>
          <div class="m-num"><span class="m-big">20</span> <span class="m-unit">%</span></div>
          <p>من إجمالي الوفيات في العالم مرتبطة بالتسمم الدموي.</p>
          <div class="m-foot"><span>مرتبطة بالإنتان</span></div>
        </div>
      </div>
      <div class="source">
        المصدر: منظمة الصحة العالمية، دراسة العبء العالمي للأمراض 2020.
      </div>
    </div>
  </section>
</Base>