---
import Base from "../layouts/Base.astro";
import { url } from "../lib/url";
import ConferenceBand from "../components/ConferenceBand.svelte";
import Countdown from "../components/Countdown.svelte";
import ConferenceForm from "../components/ConferenceForm.svelte";
import ContactForm from "../components/ContactForm.svelte";
---

<Base home>
  <ConferenceBand client:load />

  <section class="hero-home" id="top">
    <div class="hero-inner wrap">
      <div>
        <p class="kicker">التحالف السوداني للتسمم الدموي</p>
        <h1>
          <span>التسمم الدموي يقتل</span>
          <span>11 مليون إنسان</span>
          <span>كل عام حول العالم</span>
        </h1>
      </div>
      <aside class="hero-panel" aria-label="رسالتنا">
        <h2>معاً يمكننا تغيير هذا.</h2>
        <p>
          المعرفة هي أول خط دفاع. تعلّم العلامات، وتصرّف بسرعة، وساعدنا في نشر
          الوعي في كل بيت.
        </p>
        <div class="actions">
          <a class="btn" href="#symptoms">تعرّف على علامات الخطر</a>
          <a class="btn btn--ghost" href="#about">انضم إلينا</a>
        </div>
      </aside>
    </div>
    <a class="scroll-cue" href="#sepsis" tabindex="-1" aria-hidden="true">↓</a>
  </section>

  <section class="photo-grid wrap reveal" aria-label="محاور رئيسية">
    <a class="photo-card" href="#amr">
      <img
        src={url("img/amr-pills.jpg")}
        alt="شريط كبسولات مضاد حيوي"
        loading="lazy"
      />
      <div class="photo-body">
        <span class="kicker">المضادات الحيوية</span>
        <h3>مقاومة المضادات الحيوية</h3>
        <p>لماذا تصبح العدوى أصعب علاجاً، وما دورنا في إبقاء المضادات فعّالة؟</p>
        <span class="more">اعرف المزيد ←</span>
      </div>
    </a>
    <a class="photo-card" href="#symptoms">
      <img
        src={url("img/symptoms-child-care.jpg")}
        alt="عامل صحي يفحص طفلاً عند والدته"
        loading="lazy"
      />
      <div class="photo-body">
        <span class="kicker">الأطفال</span>
        <h3>اعرف العلامات</h3>
        <p>العلامات التحذيرية التي لا تنتظر — خاصة عند الرضّع وصغار الأطفال.</p>
        <span class="more">اعرف المزيد ←</span>
      </div>
    </a>
    <a class="photo-card" href="#prevention">
      <img
        src={url("img/prevention-handwash.jpg")}
        alt="غسل اليدين بالماء والصابون"
        loading="lazy"
      />
      <div class="photo-body">
        <span class="kicker">الوقاية</span>
        <h3>الوقاية تبدأ بخطوة</h3>
        <p>خطوات بسيطة تحميك وتحمي أسرتك من العدوى التي قد تتحول إلى تسمم دموي.</p>
        <span class="more">اعرف المزيد ←</span>
      </div>
    </a>
  </section>

  <section class="section wrap lazy reveal" id="about">
    <div class="what-grid">
      <h2 class="three-tone">
        <span>التوعية</span>
        <span>والتدريب</span>
        <span>والسياسات</span>
      </h2>
      <div class="what-body">
        <p>
          التحالف السوداني للتسمم الدموي تجمّع تطوعي من الأطباء والممرضين
          والصيادلة والباحثين والناشطين الصحيين، يجمعهم هدف واحد: أن لا يموت أحد
          في السودان بسبب تسمم دموي كان يمكن الوقاية منه أو علاجه.
        </p>
        <h3>رسالتنا</h3>
        <p>
          خفض الوفيات والإعاقات الناتجة عن التسمم الدموي في السودان من خلال
          التوعية المجتمعية، تدريب الكوادر الصحية، دعم السياسات المستندة إلى
          الأدلة، وبناء شبكة وطنية للاستجابة السريعة.
        </p>
        <h3>رؤيتنا</h3>
        <p>
          سودان يعرف فيه كل فرد علامات التسمم الدموي، ويجد فيه كل مريض رعاية عاجلة
          وفعّالة، أينما كان.
        </p>
        <h3>قيمنا</h3>
        <p>
          العلم والدليل في كل مادة ننشرها، السرعة في كل خطوة، العدالة في الوصول
          إلى المدينة والريف، والشراكة مع المؤسسات الصحية والمجتمعية.
        </p>
      </div>
    </div>
  </section>

  <section class="stories reveal" aria-labelledby="story-heading">
    <div class="wrap">
      <div class="carousel">
        <article class="sscontainer">
          <div class="text-section">
            <p class="kicker">قصص من الميدان</p>
            <h2 id="story-heading">لكل مريض قصة تستحق أن تُروى.</h2>
            <p class="excerpt">
              نعمل على توثيق تجارب حقيقية من السودان، بموافقة أصحابها.
            </p>
            <p class="note">
              قبل أي نشر تخضع التفاصيل الطبية لمراجعة سريرية.
            </p>
            <button class="btn btn--light" type="button" disabled>
              اقرأ القصة
            </button>
          </div>
          <div class="image-section">
            <span class="placeholder">قريباً</span>
          </div>
        </article>
        <div class="carousel-nav">
          <button type="button" disabled aria-label="الشريحة السابقة">›</button>
          <button type="button" disabled aria-label="الشريحة التالية">‹</button>
        </div>
        <div class="dots" aria-hidden="true"><span class="active"></span></div>
      </div>
    </div>
  </section>

  <section class="section wrap lazy reveal" id="impact">
    <div class="split">
      <h2>أثر التسمم الدموي</h2>
      <p>
        أرقام عالمية تعكس حجم المشكلة التي نعمل على مواجهتها في السودان.
      </p>
    </div>
    <div class="impact-grid">
      <div class="impact-item">
        <span class="arrow" aria-hidden="true">↑</span>
        <span class="num">49 <small>مليون</small></span>
        <p>حالة تسمم دموي تُسجَّل سنوياً في العالم.</p>
      </div>
      <div class="impact-item">
        <span class="arrow" aria-hidden="true">↑</span>
        <span class="num">11 <small>مليون</small></span>
        <p>وفاة سنوياً، كثير منها كان يمكن منعه.</p>
      </div>
      <div class="impact-item">
        <span class="arrow" aria-hidden="true">↑</span>
        <span class="num">20<small>%</small></span>
        <p>من إجمالي الوفيات في العالم مرتبطة بالتسمم الدموي.</p>
      </div>
    </div>
    <div class="source">
      المصدر: منظمة الصحة العالمية، دراسة العبء العالمي للأمراض 2020.
    </div>
  </section>

  <section class="section wrap lazy reveal" id="sepsis">
    <div class="split">
      <h2>ما هو التسمم الدموي؟</h2>
      <p>
        التسمم الدموي استجابة خطيرة للجسم تجاه عدوى. بدلاً من أن يهاجم الجهاز المناعي
        الميكروب فقط، يبدأ بمهاجمة أنسجة الجسم نفسه، ما قد يؤدي إلى فشل أعضاء
        متعددة والوفاة خلال ساعات. لا يفرّق بين صغير أو كبير، ولا بين مدينة
        وريف — لكن سرعة التصرف تصنع الفرق كله.
      </p>
    </div>
    <div class="prose">
      <h3>كيف يحدث؟</h3>
      <p>
        غالباً يبدأ التسمم الدموي بعدوى بكتيرية، وأحياناً فيروسية أو فطرية. أكثر
        مصادر العدوى شيوعاً هي الرئة، المسالك البولية، البطن، والجلد. عند دخول
        الميكروب إلى الدم أو انتشاره في الجسم، تطلق الاستجابة المناعية مواد
        التهابية تؤثر على الأوعية الدموية وضغط الدم ووظائف الأعضاء.
      </p>
      <div class="callout">
        <p>
          التسمم الدموي حالة طارئة. كل ساعة تأخير في التشخيص والعلاج ترفع خطر الوفاة.
        </p>
      </div>
      <h3>من هم الأكثر عرضة للخطر؟</h3>
      <ul>
        <li>الأطفال حديثو الولادة والرضّع.</li>
        <li>كبار السن، خاصة من تجاوزوا 65 عاماً.</li>
        <li>الحوامل والنفاس.</li>
        <li>من يعانون من ضعف المناعة أو يتلقون علاجاً مثبطاً للمناعة.</li>
        <li>المصابون بأمراض مزمنة كالسكري وأمراض الكلى والكبد.</li>
        <li>من خضعوا لجراحة حديثة أو لديهم قسطار أو خطوط وريدية.</li>
      </ul>
      <h3>لماذا يهمنا في السودان؟</h3>
      <p>
        يواجه نظامنا الصحي تحديات في الوصول المبكر إلى الرعاية، ونقصاً في أسرّة
        العناية المركزة والمضادات الحيوية المناسبة، إضافة إلى ضعف الوعي
        المجتمعي بعلامات الخطر. هذه العوامل تجعل سرعة التعرّف على التسمم الدموي
        والتصرف حياله أمراً حاسماً.
      </p>
    </div>
  </section>

  <section class="section wrap lazy reveal" id="symptoms">
    <div class="split">
      <h2>اعرف العلامات. تصرّف بسرعة.</h2>
      <p>
        إذا ظهرت علامة واحدة أو أكثر مع عدوى معروفة أو مشتبهة، اطلب الرعاية
        الطبية العاجلة فوراً — لا تنتظر أن تتحسن الحالة من تلقاء نفسها.
      </p>
    </div>
    <div class="rows">
      {[
        ["حرارة عالية أو منخفضة جداً", "مع قشعريرة أو رجفة غير معتادة."],
        ["تسارع التنفس", "أكثر من 22 نفساً في الدقيقة."],
        ["تسارع ضربات القلب", "أو خفقان غير مبرر."],
        ["تشوش أو ارتباك", "أو نعاس غير معتاد وصعوبة في الاستيقاظ."],
        ["انخفاض ضغط الدم", "أو دوخة شديدة عند الوقوف."],
        ["بشرة شاحبة أو مزرقة", "أو طفح لا يزول عند الضغط عليه."],
        ["قلة التبول", "أو ألم شديد وانزعاج عام غير مبرر."],
      ].map(([title, desc], i) => (
        <div class="row">
          <span class="idx">{String(i + 1).padStart(2, "0")}</span>
          <h3>{title}</h3>
          <p>{desc}</p>
        </div>
      ))}
    </div>

    <div class="split" style="margin-top: clamp(1.5rem, 4vw, 2.5rem);">
      <h2>عند الأطفال</h2>
      <p>
        الأطفال قد لا يستطيعون وصف ما يشعرون به. راقب هذه العلامات، خاصة عند
        الرضّع وصغار الأطفال.
      </p>
    </div>
    <div class="prose">
      <ul>
        <li>صعوبة في التنفس أو تنفس سريع جداً.</li>
        <li>عدم الاستجابة أو صعوبة في إيقاظ الطفل.</li>
        <li>بشرة شاحبة أو مزرقة أو باردة عند اللمس.</li>
        <li>عدم التبول أو جفاف الفم وقلة الدموع عند البكاء.</li>
        <li>بكاء مستمر لا يهدأ أو ضعف في الرضاعة.</li>
        <li>طفح جلدي لا يزول عند الضغط عليه.</li>
      </ul>
    </div>

    <div class="split" id="prevention" style="margin-top: clamp(1.5rem, 4vw, 2.5rem);">
      <h2>الوقاية</h2>
      <p>
        لا يوجد لقاح للتسمم الدموي نفسه، لكن الوقاية من العدوى والتصرف السريع عند
        ظهورها يقللان الخطر بشكل كبير.
      </p>
    </div>
    <div class="prose">
      <h3>1. عالج العدوى مبكراً</h3>
      <p>
        لا تهمل الحمى أو السعال أو التهابات المسالك البولية أو الجروح. راجع
        الطبيب في وقتها.
      </p>
      <h3>2. حافظ على النظافة</h3>
      <p>
        اغسل يديك بانتظام، واعتنِ بتنظيف الجروح، واحرص على نظافة الطعام
        والماء.
      </p>
      <h3>3. أكمل العلاج الموصوف</h3>
      <p>
        لا تتوقف عن المضادات الحيوية قبل انتهاء المدة المحددة، حتى لو تحسنت
        الأعراض.
      </p>
      <h3>4. التطعيمات</h3>
      <p>
        احرص على تطعيمات الأطفال والحوامل الموصى بها، فهي تقلل من العدوى التي
        قد تؤدي إلى التسمم الدموي.
      </p>
      <h3>5. راقب الفئات الأكثر عرضة</h3>
      <p>
        إذا كان في العائلة رضيع أو مسنّ أو شخص بضعف المناعة، فكن أكثر حذراً
        وأسرع في طلب المساعدة.
      </p>
      <div class="callout">
        <p>
          عند الشك في التسمم الدموي، اذهب إلى أقرب مستشفى أو مركز طوارئ فوراً. لا
          تنتظر موعداً عادياً.
        </p>
      </div>
      <p style="font-size: .875rem; color: var(--muted);">
        هذه المعلومات للتوعية العامة ولا تغني عن استشارة الطبيب.
      </p>
    </div>
  </section>

  <!-- shortcut: AMR content needs clinician review before publish -->
  <section class="section wrap lazy reveal" id="amr">
    <div class="split">
      <h2>مقاومة المضادات الحيوية وخطر التسمم الدموي</h2>
      <p>
        مقاومة المضادات الحيوية تجعل علاج التسمم الدموي أكثر صعوبة. الميكروبات التي
        تسبب العدوى تتطور وتصبح مقاومة للأدوية، مما يؤخر العلاج الفعّال ويرفع
        خطر الوفاة.
      </p>
    </div>
    <div class="prose">
      <p>
        منظمة الصحة العالمية تصف مقاومة المضادات الحيوية بأنها أحد أكبر التهديدات
        الصحية العالمية. كل عام يموت ما لا يقل عن 1.2 مليون شخص حول العالم بسبب
        العدوى المقاومة للمضادات الحيوية.
      </p>
      <h3>كيف تحمي فعالية المضادات الحيوية؟</h3>
      <ul>
        <li>لا تتناول المضادات الحيوية إلا بوصفة طبية.</li>
        <li>أكمل الجرعة الموصوفة كاملة حتى لو تحسنت الأعراض.</li>
        <li>لا تطلب مضادات حيوية لعلاج نزلات البرد أو الإنفلونزا — فهي فيروسية ولا تستجيب.</li>
        <li>احرص على التطعيمات للوقاية من العدوى من الأساس.</li>
        <li>اغسل يديك بانتظام واعتنِ بنظافة الجروح.</li>
      </ul>
      <div class="callout">
        <p>المضادات الحيوية ليست دواءً لجميع الأمراض. استخدامها الخاطئ يهدد قدرتها على إنقاذ الأرواح عند الحاجة الحقيقية.</p>
      </div>
      <p style="font-size: .875rem; color: var(--muted);">
        هذه المعلومات للتوعية العامة وتحتاج مراجعة سريرية قبل النشر. المصادر: منظمة الصحة العالمية، التحالف العالمي للإنتان.
      </p>
    </div>
  </section>


  <section class="section wrap lazy reveal" id="conference">
    <div class="split">
      <h2>مؤتمر كسلا للتسمم الدموي</h2>
      <p>
        لقاء وطني يجمع الكوادر الصحية وصنّاع القرار لمناقشة الكشف المبكر عن
        التسمم الدموي والاستجابة السريعة له في السودان.
      </p>
    </div>
    <div class="contact-grid">
      <div>
        <div class="rows">
          <div class="row" style="grid-template-columns: 8rem 1fr;">
            <span class="idx">التاريخ</span>
            <h3>الاثنين 30 نوفمبر 2026</h3>
          </div>
          <div class="row" style="grid-template-columns: 8rem 1fr;">
            <span class="idx">الوقت</span>
            <h3>9:00 صباحاً بتوقيت الخرطوم</h3>
          </div>
          <div class="row" style="grid-template-columns: 8rem 1fr;">
            <span class="idx">المكان</span>
            <h3>كسلا — يُعلن الموقع الدقيق قريباً</h3>
          </div>
          <div class="row" style="grid-template-columns: 8rem 1fr;">
            <span class="idx">التسجيل</span>
            <h3>مفتوح حتى 16 نوفمبر 2026</h3>
          </div>
        </div>
        <div style="margin-top: 1.5rem;">
          <Countdown client:visible />
        </div>
      </div>
      <div>
        <h3 style="font-size: 1.25rem; margin-bottom: .75rem;">سجّل حضورك</h3>
        <p style="color: var(--muted); margin-bottom: 1.5rem;">
          بعد إتمام التسجيل سنرسل تفاصيل الحضور والبرنامج إلى بريدك الإلكتروني.
        </p>
        <ConferenceForm client:visible />
      </div>
    </div>
  </section>

  <section class="section wrap lazy reveal" id="contact">
    <div class="contact-grid">
      <div class="prose">
        <h2>اتصل بنا</h2>
        <p>
          استفسار، فكرة شراكة، أو رغبة في الانضمام؟ اترك رسالتك وسنعود إليك في
          أقرب وقت. نرحب بالتواصل من الكوادر الصحية، المؤسسات، الطلاب،
          والإعلام.
        </p>
        <p>
          ملاحظة: هذه الصفحة ليست قناة طوارئ طبية. إذا كنت تشك في إصابة شخص
          بالتسمم الدموي، فاتجه فوراً إلى أقرب مستشفى.
        </p>
        <p>
          تفاصيل المؤتمر على <a href={url("conference")}>صفحة مؤتمر كسلا</a>.
        </p>
      </div>
      <ContactForm client:visible />
    </div>
  </section>
</Base>
